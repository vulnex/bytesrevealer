{
  "name": "bytesrevealer",
  "version": "0.5",
  "description": "A Vue.js reverse engineering visualization tool",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "generate-favicon": "node scripts/generate-favicon.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,json,md}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,json,md}\" \"*.{js,json,md}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "capstone-wasm": "1.0.3",
    "crypto-js": "4.2.0",
    "file-type": "21.3.4",
    "iconv-lite": "0.7.3",
    "idb": "7.1.1",
    "jszip": "3.10.1",
    "kaitai-struct": "0.11.0",
    "libyara-wasm": "1.2.1",
    "pinia": "3.0.4",
    "vue": "3.5.40",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "happy-dom": "20.11.1",
    "husky": "9.1.7",
    "js-yaml": "4.3.0",
    "lint-staged": "16.3.0",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "7.0.1",
    "terser": "5.49.0",
    "vite": "7.3.6",
    "vite-plugin-compression2": "2.5.3",
    "vitest": "4.1.10",
    "vue-eslint-parser": "10.4.1"
  }
}
